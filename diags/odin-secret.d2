# odin-secret: its place in the binding graph
# Render:  d2 diags/odin-secret.d2 diags/odin-secret.svg

direction: down

title: "odin-secret" {
  shape: text
  near: top-center
  style.font-size: 28
  style.bold: true
}

this: "odin-secret\nlibsecret 0.21.4" {
  style.fill: "#eef6ff"
}
lib: "libsecret-1 (shared library)" {
  style.fill: "#fff6e6"
}
consumers: "every other binding and every app\nimport \"secret:<pkg>\"" {
  style.fill: "#f2f2f2"
}

consumers -> this: collection secret
this -> lib: foreign import
